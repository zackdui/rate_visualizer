# Copy to .env (git-ignored) and fill in. Never commit .env or paste these values anywhere.
# See docs/rates_tool_hosting_plan.md, sections 4 and 10.

# --- Cloudflare R2 (S3-compatible API) ---------------------------------------------------------------
# Laptop: the read & write token "rates-tool-pipeline". Render: the read-only token "rates-tool-site".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rates-tool-data
# Where the site looks for the pointer to the current site.duckdb
SITE_MANIFEST_KEY=sites/TX/latest.json

# --- Render ------------------------------------------------------------------------------------------
# Laptop only: POSTing to this URL restarts the site so it loads the newest data.
RENDER_DEPLOY_HOOK_URL=

# --- Site (Render sets PORT itself) ------------------------------------------------------------------
# Optional, for later: password-protect the site.
SITE_PASSWORD=

# --- Optional (development / tuning) -----------------------------------------------------------------
# SITE_DB_PATH=data/TX/2026-08-20/site.duckdb   # use a local site.duckdb instead of downloading from R2
# SITE_CACHE_DIR=.site_cache                     # where the site keeps its downloaded copy
# DUCKDB_MEMORY_LIMIT=1GB
# DUCKDB_THREADS=0                               # 0 = DuckDB default
